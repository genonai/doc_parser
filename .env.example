# ====================================================
# 지능형 전처리기 FastAPI 서버 Docker Compose 설정
# ====================================================
# 사용 방법:
#   1. 이 파일을 .env 로 복사: cp .env.example .env
#   2. 필수값 설정 (특히 HF_TOKEN)
#   3. docker-compose up -d

# ====================================================
# [필수] HuggingFace 토큰
# ====================================================
# 용도: HWP/PDF SDK 다운로드, 모델 다운로드
# 발급: https://huggingface.co/settings/tokens
# 주의: Private Token 필요! (문서/SDK 다운로드용)
HF_TOKEN=hf_your_token_here

# ====================================================
# [선택] API 포트
# ====================================================
# intelligent_preprocessor API 포트 (기본값: 7085)
API_PORT=7085

# ====================================================
# [선택] OCR 서버 포트
# ====================================================
# PaddleOCR 서버 포트 (기본값: 48080)
# OCR 서버를 사용하려면: docker-compose --profile with-ocr up
OCR_PORT=48080

# ====================================================
# [선택] 로깅 레벨
# ====================================================
# DEBUG, INFO (기본값), WARNING, ERROR
LOG_LEVEL=INFO

# ====================================================
# [선택] 리소스 제한
# ====================================================
# CPU/메모리 리소스 제한 (docker-compose 내 deploy.resources 참고)

# CPU 제한 (예: 4, 2.5)
CPU_LIMIT=4

# CPU 예약 (컨테이너 시작 시 보장)
CPU_RESERVE=2

# 메모리 제한 (예: 16G, 8192M)
MEMORY_LIMIT=16G

# 메모리 예약
MEMORY_RESERVE=8G

# ====================================================
# 추가 환경 변수 (선택)
# ====================================================

# Python 언어 설정
# LANG=ko_KR.UTF-8
# LC_ALL=ko_KR.UTF-8

# HuggingFace 캐시 경로 (Docker 내부)
# HF_HOME=/app/.cache/huggingface

# Docling 모델 경로
# DOCLING_ARTIFACTS_PATH=/models

# PDF SDK 경로 (자동 감지)
# PDF_SDK_HOME=/app/pdf_sdk

# 임시 파일 경로
# TMPDIR=/app/tmp
